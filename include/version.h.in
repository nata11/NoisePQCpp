// Compile-time version check macro
#define NOISEPQC_VERSION_AT_LEAST(major, minor, patch) \
    (NOISEPQC_VERSION_MAJOR > (major) || \
     (NOISEPQC_VERSION_MAJOR == (major) && NOISEPQC_VERSION_MINOR > (minor)) || \
     (NOISEPQC_VERSION_MAJOR == (major) && NOISEPQC_VERSION_MINOR == (minor) && \
      NOISEPQC_VERSION_PATCH >= (patch)))

// C++ API
namespace NoisePQC {
    namespace Version {
        // Version number components
        inline constexpr int MAJOR = @PROJECT_VERSION_MAJOR@;
        inline constexpr int MINOR = @PROJECT_VERSION_MINOR@;
        inline constexpr int PATCH = @PROJECT_VERSION_PATCH@;

        // Full version string
        inline constexpr const char* STRING = "@PROJECT_VERSION@";

        // Git information (may be empty for release builds)
        inline constexpr const char* GIT_COMMIT = "@GIT_COMMIT_HASH@";
        inline constexpr const char* GIT_BRANCH = "@GIT_BRANCH@";

        // Build timestamp
        inline constexpr const char* BUILD_DATE = "@BUILD_DATE@";

        /**
         * @brief Check if running version is at least the specified version
         *
         * @param major Major version number
         * @param minor Minor version number
         * @param patch Patch version number (default: 0)
         * @return true if current version >= specified version
         *
         * @example
         * if (NoisePQC::Version::check(0, 3, 0)) {
         *     // Use features available in 0.3.0+
         * }
         */
        constexpr bool check(int major, int minor, int patch = 0) noexcept {
            return (MAJOR > major) ||
                   (MAJOR == major && MINOR > minor) ||
                   (MAJOR == major && MINOR == minor && PATCH >= patch);
        }

        /**
         * @brief Get version as string in MAJOR.MINOR.PATCH format
         *
         * @return Version string (e.g., "0.3.0")
         */
        inline constexpr const char* to_string() noexcept {
