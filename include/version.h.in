         * @return Full version string including git commit if available
         *
         * @example
         * "0.3.0" (release build)
         * "0.3.0+g5114f85" (development build with git info)
         */
        inline std::string full_version() {
            std::string result = STRING;
            if (std::string_view(GIT_COMMIT).length() > 0) {
                result += "+g";
                result += GIT_COMMIT;
            }
            return result;
        }

        /**
         * @brief Print version information to stream
