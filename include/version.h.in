        inline void print_info(std::ostream& os = std::cout) {
            os << "NoisePQC++ version: " << STRING << "\n";
            if (std::string_view(GIT_COMMIT).length() > 0) {
                os << "Git commit: " << GIT_COMMIT;
                if (std::string_view(GIT_BRANCH).length() > 0) {
                    os << " (" << GIT_BRANCH << ")";
                }
                os << "\n";
            }
            os << "Built: " << BUILD_DATE << "\n";
        }
