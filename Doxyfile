# Doxyfile for NoisePQC++
# Noise Protocol Framework with Post-Quantum Cryptography (PQC) and
# Hybrid Forward Secrecy (HFS) — C++23 reference implementation.

#---------------------------------------------------------------------------
# Project metadata
#---------------------------------------------------------------------------
PROJECT_NAME           = "NoisePQC++"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "C++23 Noise Protocol Framework with Post-Quantum Cryptography and Hybrid Forward Secrecy"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs/api-reference

#---------------------------------------------------------------------------
# Input sources
#---------------------------------------------------------------------------
INPUT                  = src/ \
                         docs/ \
                         README.md
FILE_PATTERNS          = *.cppm *.md
RECURSIVE              = NO
EXTENSION_MAPPING      = cppm=C++
USE_MDFILE_AS_MAINPAGE = README.md

# Exclude build artifacts and third-party code
EXCLUDE_PATTERNS       = */cmake-build-*/* \
                         */_deps/* \
                         */third_party/*

#---------------------------------------------------------------------------
# Extraction behavior
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

#---------------------------------------------------------------------------
# Documentation style
#---------------------------------------------------------------------------
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = /Users/nahmed/CLionProjects/NoisePQC++
STRIP_FROM_INC_PATH    = /Users/nahmed/CLionProjects/NoisePQC++
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

#---------------------------------------------------------------------------
# Build configuration
#---------------------------------------------------------------------------
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
GENERATE_TODOLIST      = YES
GENERATE_BUGLIST       = YES

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# Output formats
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# Graphs and diagrams (disabled — no dot/Graphviz dependency)
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_GRAPH            = NO

#---------------------------------------------------------------------------
# Preprocessing (for NOISE_DEBUG_BUILD conditional sections)
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
PREDEFINED             =
SKIP_FUNCTION_MACROS   = YES

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
